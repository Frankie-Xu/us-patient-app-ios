# Copy this file to a local secret-managed env file before starting Compose.
# These placeholders are synthetic and must be replaced outside version control.
POSTGRES_DB=patient_staging
POSTGRES_USER=patient_staging
POSTGRES_PASSWORD=replace-with-staging-secret
S3_ACCESS_KEY=patient_staging
S3_SECRET_KEY=replace-with-staging-secret
REDIS_PASSWORD=replace-with-staging-secret
REDIS_QUEUE=patient-app-processing
S3_BUCKET=patient-documents
OBJECT_STORAGE_REGION=us-east-1
API_BASE_URL=http://localhost:58000
AI_PROVIDER=stub
STAGING_DATA_CLASSIFICATION=deidentified
WORKER_MODE=queue-consumer-fixture-ocr
OCR_PROVIDER=fixture
# Set only in the ignored local/secret-managed env file after provider and
# regional data-processing terms are approved. Never put these in iOS.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=qwen3.5-ocr
DASHSCOPE_OCR_TASK=text_recognition
DASHSCOPE_TIMEOUT_SECONDS=60
DASHSCOPE_MAX_PDF_PAGES=20
DASHSCOPE_PDF_RASTER_DPI=150
WORKER_CONSUMER_ENABLED=1
WORKER_MAX_ATTEMPTS=3
WORKER_LEASE_SECONDS=60
WORKER_METADATA_WAIT_ATTEMPTS=3
STAGING_AUTH_USERNAME=replace-with-local-staging-username
STAGING_AUTH_PASSWORD=replace-with-local-staging-password
STAGING_AUTH_SECRET=replace-with-at-least-32-byte-local-secret
STAGING_AUTH_ISSUER=local-staging
STAGING_AUTH_AUDIENCE=patient-app
STAGING_AUTH_SUBJECT=staging-patient
STAGING_AUTH_ACCESS_TTL_SECONDS=900
STAGING_AUTH_REFRESH_TTL_SECONDS=2592000
STAGING_API_PORT=58000
STAGING_WORKER_PORT=58001
STAGING_POSTGRES_PORT=55432
STAGING_S3_PORT=59000
