# Copy to .env for a local staging rehearsal. Do not commit real values.
STAGING_POSTGRES_DB=patient_app_staging
STAGING_POSTGRES_USER=patient_app
STAGING_POSTGRES_PASSWORD=replace-with-a-local-secret
STAGING_POSTGRES_PORT=5433
STAGING_S3_ENDPOINT=http://minio:9000
STAGING_S3_ACCESS_KEY=replace-with-a-local-access-key
STAGING_S3_SECRET_KEY=replace-with-a-local-secret
STAGING_S3_BUCKET=patient-app-staging
STAGING_S3_PORT=9000
STAGING_S3_CONSOLE_PORT=9001
STAGING_API_PORT=8080
STAGING_AI_WORKER_PORT=8090
STAGING_TASK_WORKER_PORT=8091
STAGING_RUNTIME_IMAGE=python:3.12-slim
# Synthetic adapters are deterministic and require no provider credentials.
STAGING_ADAPTER_MODE=synthetic
STAGING_OCR_PROVIDER=deterministic
STAGING_EXTRACTION_PROVIDER=deterministic
STAGING_TASK_MODE=synthetic
STAGING_MIGRATION_VERSION=1
STAGING_MIGRATION_NAME=0001_initial
