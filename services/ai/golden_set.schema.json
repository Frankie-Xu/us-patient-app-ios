{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patient-app.invalid/schemas/ai-golden-set.json",
  "title": "Synthetic AI evaluation golden set",
  "type": "object",
  "required": ["dataset_id", "version", "data_classification", "cases"],
  "additionalProperties": false,
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "data_classification": {"enum": ["synthetic", "deidentified"]},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "document", "expected_claims", "expected_conflicts"],
        "additionalProperties": false,
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "data_classification": {"enum": ["synthetic", "deidentified"]},
          "document": {
            "type": "object",
            "required": ["source_ref", "source_type", "text"],
            "additionalProperties": false,
            "properties": {
              "source_ref": {"type": "string", "minLength": 1},
              "source_type": {"type": "string", "minLength": 1},
              "text": {"type": "string", "minLength": 1}
            }
          },
          "expected_claims": {
            "type": "array",
            "items": {"$ref": "#/$defs/claim"}
          },
          "expected_conflicts": {
            "type": "array",
            "items": {"$ref": "#/$defs/conflict"}
          }
        }
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": ["claim_id", "text_en", "text_zh", "source_ref", "source_type", "confidence", "review_status"],
      "additionalProperties": false,
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "text_en": {"type": "string", "minLength": 1},
        "text_zh": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "source_type": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "review_status": {"enum": ["unreviewed", "needs_review", "accepted", "rejected"]},
        "normalized_key": {"type": "string"},
        "normalized_value": {"type": "string"},
        "rewritten": {"type": "boolean"}
      }
    },
    "conflict": {
      "type": "object",
      "required": ["conflict_id", "claim_ids", "severity"],
      "additionalProperties": false,
      "properties": {
        "conflict_id": {"type": "string", "minLength": 1},
        "claim_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "reason": {"type": "string"}
      }
    }
  }
}
