# Local development only. Never commit real credentials.
APP_ENV=local
API_BASE_URL=http://localhost:8000
OBJECT_STORAGE_BUCKET=local
OBJECT_STORAGE_REGION=local
AI_PROVIDER=stub
IDENTITY_ISSUER=ref://local/identity-issuer
IDENTITY_AUDIENCE=patient-app
DATABASE_URL_REF=ref://local/database
QUEUE_NAME=local-processing
KMS_KEY_ID_REF=ref://local/kms-key
SECRET_REF_PREFIX=ref://local/
OTEL_EXPORTER_OTLP_ENDPOINT=

# Staging and production require HTTPS, explicit identity/audience, provider-neutral
# secret references, a region, a queue name and a KMS key reference. Keep actual
# values in the approved secret/configuration manager; never place them here.
